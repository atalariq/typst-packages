% Primary reference: The standard algorithms textbook.
% Covers Stack (Section 10.1), Queue (Section 10.1), Linked List (Section 10.2),
% and complexity analysis throughout.
@book{cormen2022,
  author    = {Thomas H. Cormen and Charles E. Leiserson and Ronald L. Rivest and Clifford Stein},
  title     = {Introduction to Algorithms},
  edition   = {4th},
  publisher = {The MIT Press},
  year      = {2022},
  isbn      = {9780262046305},
}

% Covers practical implementations of Stack and Queue with analysis.
% Chapter 1 (Fundamental Data Structures) is directly relevant.
@book{sedgewick2011,
  author    = {Robert Sedgewick and Kevin Wayne},
  title     = {Algorithms},
  edition   = {4th},
  publisher = {Addison-Wesley Professional},
  year      = {2011},
  isbn      = {9780321573513},
}

% Foundational ADT theory and data structure design.
% Chapter 1 introduces the ADT concept and its role in software design.
@book{aho1983,
  author    = {Alfred V. Aho and John E. Hopcroft and Jeffrey D. Ullman},
  title     = {Data Structures and Algorithms},
  publisher = {Addison-Wesley},
  year      = {1983},
  isbn      = {9780201000238},
}

